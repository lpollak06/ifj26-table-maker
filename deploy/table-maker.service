# Changes: Runs the release behind /opt/table-maker/current (see deploy/deploy.sh), refuses to start on a Node without
#          unflagged node:sqlite (< 22.13), and is further hardened (no capabilities, @system-service syscall filter,
#          read-only kernel/clock/hostname, hidden /proc, private umask).

[Unit]
Description=IFJ26 Table Maker
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=table-maker
WorkingDirectory=/opt/table-maker/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4310
Environment=TABLE_MAKER_DB=/var/lib/table-maker/table-maker.db
# Same check as deploy.sh runs before a restart; keep the node path in sync with ExecStart=.
ExecStartPre=/usr/local/bin/node --no-warnings -e "const [a, b] = process.versions.node.split('.').map(Number); if (a < 22 || (a === 22 && b < 13) || !process.getBuiltinModule('node:sqlite')) { console.error('table-maker: need Node >= 22.13 with node:sqlite, got ' + process.version); process.exit(1) }"
ExecStart=/usr/local/bin/node /opt/table-maker/current/server/index.mjs
Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
# Binds an unprivileged port on 127.0.0.1 – needs no capabilities at all.
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
# Only /proc/<pid> is visible; libuv falls back to sysinfo() for the memory size. If os.cpus()/loadavg are ever
# needed, drop this line.
ProcSubset=pid
UMask=0077
# MemoryDenyWriteExecute= is deliberately NOT set: V8's JIT needs writable+executable memory and Node aborts with it.

[Install]
WantedBy=multi-user.target
