# AI generated by: Claude Code / claude-opus-5-5
# Prompt: "i changed my mind could you host in on the t3-exec vm, its should be accessible through tailscale"
# Changes: systemd unit for the Table Maker server; listens on localhost only (Tailscale Serve publishes it),
#          runs as a sandboxed dynamic user and keeps the SQLite database in /var/lib/table-maker.

[Unit]
Description=IFJ26 Table Maker
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=table-maker
WorkingDirectory=/opt/table-maker
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4310
Environment=TABLE_MAKER_DB=/var/lib/table-maker/table-maker.db
ExecStart=/usr/local/bin/node /opt/table-maker/server/index.mjs
Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
